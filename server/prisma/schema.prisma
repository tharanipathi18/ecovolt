generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(uuid())
  name                 String
  email                String              @unique
  password             String
  role                 String              @default("ev_user")
  phone                String?
  avatar               String?
  addressStreet        String?
  addressCity          String?
  addressState         String?
  addressZipCode       String?
  addressCountry       String?             @default("USA")
  isActive             Boolean             @default(true)
  isEmailVerified      Boolean             @default(false)
  lastLogin            DateTime?
  resetPasswordToken   String?
  resetPasswordExpire  DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  bookings             Booking[]
  chargingPorts        ChargingPort[]
  queues               ChargingQueue[]
  chargingSessions     ChargingSession[]
  driversEmployed      Driver[]            @relation("DriverEmployer")
  driverProfile        Driver?             @relation("DriverUser")
  generators           EnergyGenerator[]
  fleetVehiclesManaged FleetVehicle[]      @relation("FleetManager")
  maintenanceReports   MaintenanceReport[]
  notifications        Notification[]
  payments             Payment[]
  vehicles             Vehicle[]

  @@map("users")
}

model Vehicle {
  id                   String              @id @default(uuid())
  ownerId              String
  make                 String
  model                String
  year                 Int
  licensePlate         String              @unique
  vin                  String?             @unique
  batteryCapacityKwh   Float
  currentStateOfCharge Float               @default(80)
  connectorType        String
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  batteryReports       BatteryReport[]
  bookings             Booking[]
  queues               ChargingQueue[]
  chargingSessions     ChargingSession[]
  maintenanceReports   MaintenanceReport[]
  owner                User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("vehicles")
}

model EnergyGenerator {
  id               String                @id @default(uuid())
  name             String
  operatorId       String
  type             String
  capacityKw       Float
  currentOutputKw  Float                 @default(0)
  excessEnergyKw   Float                 @default(0)
  tariffRatePerKwh Float                 @default(0.15)
  totalRevenue     Float                 @default(0)
  status           String                @default("active")
  gridConnection   String                @default("grid")
  locationAddress  String?
  locationCity     String?
  locationState    String?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  operator         User                  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  productionLogs   EnergyProductionLog[]
  transactions     EnergyTransaction[]
  linkedPorts      ChargingPort[]        @relation("GeneratorToPort")

  @@map("energy_generators")
}

model ChargingPort {
  id                 String              @id @default(uuid())
  operatorId         String
  stationName        String
  portIdentifier     String
  connectorType      String
  maxPowerOutputKw   Float               @default(50)
  status             String              @default("available")
  pricingRatePerKwh  Float               @default(0.35)
  isPublic           Boolean             @default(true)
  latitude           Float?
  longitude          Float?
  locationAddress    String?
  locationCity       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  approvalStatus     String              @default("APPROVED")
  businessName       String?
  documentsUrl       String?
  isApproved         Boolean             @default(true)
  licenseNumber      String?
  numberOfPorts      Int                 @default(1)
  ownerName          String?
  phone              String?
  photosUrl          String?
  bookings           Booking[]
  operator           User                @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  queues             ChargingQueue[]
  sessions           ChargingSession[]
  transactions       EnergyTransaction[]
  maintenanceReports MaintenanceReport[]
  linkedGenerators   EnergyGenerator[]   @relation("GeneratorToPort")

  @@map("charging_ports")
}

model ChargingQueue {
  id                       String       @id @default(uuid())
  chargingPortId           String
  userId                   String
  vehicleId                String
  queuePosition            Int
  estimatedWaitTimeMinutes Int          @default(15)
  status                   String       @default("waiting")
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  chargingPort             ChargingPort @relation(fields: [chargingPortId], references: [id], onDelete: Cascade)
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle                  Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("charging_queues")
}

model ChargingSession {
  id                        String       @id @default(uuid())
  userId                    String
  chargingPortId            String
  vehicleId                 String
  startTime                 DateTime     @default(now())
  endTime                   DateTime?
  startStateOfCharge        Float
  endStateOfCharge          Float?
  energyConsumedKwh         Float        @default(0)
  cost                      Float        @default(0)
  renewableEnergyPercentage Float        @default(100)
  status                    String       @default("active")
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  chargingPort              ChargingPort @relation(fields: [chargingPortId], references: [id], onDelete: Cascade)
  user                      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle                   Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  payment                   Payment?

  @@map("charging_sessions")
}

model Booking {
  id                 String       @id @default(uuid())
  bookingReference   String       @unique
  userId             String
  chargingPortId     String
  vehicleId          String
  scheduledStartTime DateTime
  durationMinutes    Int          @default(45)
  status             String       @default("pending")
  estimatedCost      Float        @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  chargingPort       ChargingPort @relation(fields: [chargingPortId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle            Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

model EnergyTransaction {
  id                   String          @id @default(uuid())
  transactionReference String          @unique
  generatorId          String
  chargingPortId       String
  energyAmountKwh      Float
  tariffRatePerKwh     Float
  totalCost            Float
  status               String          @default("settled")
  timestamp            DateTime        @default(now())
  createdAt            DateTime        @default(now())
  chargingPort         ChargingPort    @relation(fields: [chargingPortId], references: [id], onDelete: Cascade)
  generator            EnergyGenerator @relation(fields: [generatorId], references: [id], onDelete: Cascade)

  @@map("energy_transactions")
}

model FleetVehicle {
  id                       String                @id @default(uuid())
  fleetName                String
  managerId                String
  assignedDriverId         String?               @unique
  fleetUnitNumber          String
  chargingPriority         String                @default("medium")
  preferredChargeStartTime String?
  targetStateOfCharge      Float                 @default(90)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  batteryCapacityKwh       Float                 @default(60.0)
  connectorType            String                @default("ccs_2")
  make                     String
  manufacturingYear        Int                   @default(2023)
  model                    String
  odometer                 Float                 @default(0)
  registrationNumber       String                @unique
  vehicleStatus            String                @default("ACTIVE")
  vehicleType              String                @default("van")
  complaints               Complaint[]
  assignedDriver           Driver?               @relation(fields: [assignedDriverId], references: [id])
  manager                  User                  @relation("FleetManager", fields: [managerId], references: [id], onDelete: Cascade)
  maintenanceSchedules     MaintenanceSchedule[]

  @@map("fleet_vehicles")
}

model Driver {
  id                    String        @id @default(uuid())
  userId                String        @unique
  licenseNumber         String        @unique
  licenseExpirationDate DateTime
  drivingRating         Float         @default(5.0)
  ecoScore              Float         @default(100.0)
  status                String        @default("available")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  employerManagerId     String
  complaints            Complaint[]
  employer              User          @relation("DriverEmployer", fields: [employerManagerId], references: [id], onDelete: Cascade)
  user                  User          @relation("DriverUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedFleetVehicle  FleetVehicle?

  @@map("drivers")
}

model Complaint {
  id                  String               @id @default(uuid())
  fleetVehicleId      String
  driverId            String
  managerId           String
  title               String
  description         String
  category            String               @default("OTHER")
  priority            String               @default("MEDIUM")
  status              String               @default("OPEN")
  reportedAt          DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  driver              Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  fleetVehicle        FleetVehicle         @relation(fields: [fleetVehicleId], references: [id], onDelete: Cascade)
  maintenanceSchedule MaintenanceSchedule?

  @@map("complaints")
}

model MaintenanceSchedule {
  id              String       @id @default(uuid())
  fleetVehicleId  String
  complaintId     String?      @unique
  managerId       String
  mechanic        String
  workshop        String
  maintenanceDate DateTime
  estimatedCost   Float        @default(0)
  actualCost      Float?
  description     String
  status          String       @default("SCHEDULED")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  complaint       Complaint?   @relation(fields: [complaintId], references: [id])
  fleetVehicle    FleetVehicle @relation(fields: [fleetVehicleId], references: [id], onDelete: Cascade)

  @@map("maintenance_schedules")
}

model MaintenanceReport {
  id             String        @id @default(uuid())
  vehicleId      String
  chargingPortId String?
  reportedById   String
  title          String
  description    String
  priority       String        @default("medium")
  status         String        @default("open")
  estimatedCost  Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  chargingPort   ChargingPort? @relation(fields: [chargingPortId], references: [id])
  reportedBy     User          @relation(fields: [reportedById], references: [id], onDelete: Cascade)
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("maintenance_reports")
}

model BatteryReport {
  id                 String   @id @default(uuid())
  vehicleId          String
  voltage            Float
  fastChargeCycles   Int
  reportedAt         DateTime @default(now())
  diagnosticStatus   String   @default("healthy")
  internalResistance Float?
  packTemperature    Float
  stateOfHealth      Float
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("battery_reports")
}

model EnergyProductionLog {
  id                String          @id @default(uuid())
  generatorId       String
  energyProducedKwh Float
  peakOutputKw      Float
  loggedAt          DateTime        @default(now())
  generator         EnergyGenerator @relation(fields: [generatorId], references: [id], onDelete: Cascade)

  @@map("energy_production_logs")
}

model Payment {
  id                String          @id @default(uuid())
  userId            String
  amount            Float
  currency          String          @default("USD")
  paymentMethod     String          @default("credit_card")
  status            String          @default("completed")
  createdAt         DateTime        @default(now())
  chargingSessionId String          @unique
  transactionId     String          @unique
  chargingSession   ChargingSession @relation(fields: [chargingSessionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info")
  severity  String   @default("low")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
